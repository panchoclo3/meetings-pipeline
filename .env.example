# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env real a un repositorio.

# API key de Anthropic (console.anthropic.com) — usada en el paso 2 (extracción)
ANTHROPIC_API_KEY=sk-ant-...

# Token de HuggingFace (huggingface.co/settings/tokens) — usado por pyannote
# para diarización en el paso 1. También debes aceptar las condiciones de uso
# de estos dos modelos en la web de HuggingFace antes de que funcione:
#   - pyannote/speaker-diarization-3.1
#   - pyannote/segmentation-3.0
HF_TOKEN=hf_...

# Integration token de Notion (www.notion.so/my-integrations) — usado en el
# paso 4 para crear páginas, en los pasos 5/6 para leer, y en el paso 7
# para crear/actualizar páginas en la base "Decisiones".
NOTION_API_KEY=secret_...

# IDs de las bases de datos de Notion (ver config.yaml → notion.*_database_id_env
# para los nombres exactos de estas variables). No se guardan en config.yaml
# porque ese archivo se versiona en git.
NOTION_REUNIONES_DATABASE_ID=...
NOTION_TAREAS_DATABASE_ID=...
NOTION_DECISIONES_DATABASE_ID=...
